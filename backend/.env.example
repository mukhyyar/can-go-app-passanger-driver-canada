# CAN-GO backend — copy to `.env` and fill secrets locally.
# NEVER commit real credentials (Firebase Admin JSON, payment keys, etc.).

NODE_ENV=local
PORT=4000
APP_NAME=can-go-api
LOG_LEVEL=debug

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://cango:cango@127.0.0.1:5433/cango?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Object storage (MinIO local)
S3_ENDPOINT=http://127.0.0.1:9000
# Host phones/browsers use. Signed URLs are *generated* against this endpoint
# (do not rewrite after signing — that breaks SigV4). Example LAN:
# S3_PUBLIC_ENDPOINT=http://192.168.100.5:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cango
S3_SECRET_KEY=cangominio
S3_BUCKET_DOCUMENTS=cango-documents
S3_FORCE_PATH_STYLE=true

# Auth (generate strong secrets before staging/prod)
JWT_ACCESS_SECRET=change-me-access-local-only
JWT_REFRESH_SECRET=change-me-refresh-local-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Social OAuth (web GIS / Apple JS → Nest verifies ID tokens)
# Comma-separated allowed audiences (web + native client IDs)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=
# Local/dev: AuthModal can mock Google/Apple when client IDs are empty
# (forced off when NODE_ENV=production)
OAUTH_LOCAL_MOCK=true

# Provider selection (local/dev defaults)
PAYMENT_PROVIDER=dev
PAYOUT_PROVIDER=dev
SMS_PROVIDER=mock
OTP_PROVIDER=prisma

# Phase 2 — Stripe (set PAYMENT_PROVIDER=stripe / PAYOUT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 2 — Twilio SMS (set SMS_PROVIDER=twilio; keep OTP_PROVIDER=prisma)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase 2 — require admin TOTP enrollment before login
ADMIN_TOTP_ENFORCE=false

# Firebase Admin — path to service account JSON outside git, OR base64 JSON
# Create at: Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=can-go-platform
# From secrets/can-go-platform-firebase-adminsdk.json → client_email
FIREBASE_CLIENT_EMAIL=
# Prefer file path over embedding JSON in env when possible:
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/can-go-platform-firebase-adminsdk.json
# Or set FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:5050,http://127.0.0.1:5051,http://127.0.0.1:5052

# Admin impersonation landing pages
PASSENGER_WEB_BASE=http://127.0.0.1:3002
ADMIN_WEB_BASE=http://127.0.0.1:3001
IMPERSONATION_TTL_MINUTES=12

# Maps — Google Maps only (Geocoding + Directions + Places API New)
# Restrict server key by IP. Local: use a separate API-restricted-only key if IP block fails.
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Browser Maps JS key (HTTP referrers). Flutter web + admin/passenger fetch via GET /api/maps/browser-config
# or NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Local: can match GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_BROWSER_API_KEY=

# Launch gate — production must keep these false until staging E2E with real providers passes
ALLOW_DEV_PAYMENT_IN_PRODUCTION=false
ALLOW_MOCK_SMS_IN_PRODUCTION=false
# Set true ONLY after staging E2E (marketplace→trip→rating) is green on real Stripe/Twilio
STAGING_E2E_PASSED=false
# Emergency bypass for STAGING_E2E_PASSED (never in normal deploys)
ALLOW_PROD_WITHOUT_STAGING_E2E=false
